//0x10
testfunction DiagnosticSessionControl(byte subid)
{
  byte functionid = 0x10;
  byte buffer[2];
  buffer[0] = functionid;
  buffer[1] = subid;
  DoIP_DataReq(buffer, 2, vehicleLogicAddress, TesterLogicalAddress);
}

//0x36
testfunction TransferData(byte data[],int datasize)
{
  DoIP_DataReq(data, datasize, vehicleLogicAddress, TesterLogicalAddress);
}

//0x37
testfunction RequestTransferExit(byte subid)
{
  byte functionid = 0x10;
  byte buffer[2];
  buffer[0] = functionid;
  buffer[1] = subid;
  DoIP_DataReq(buffer, 2, vehicleLogicAddress, TesterLogicalAddress);
}


//0x38
testfunction RequestFileTransfer()
{
  byte functionid = 0x38;
  byte filePathandNameLength = 0x1F;
  byte filePathandName[31] = {0x2F,0x68,0x6F,0x6D,0x65,0x2F,0x75,0x73,0x65,0x72,0x2F,0x64,0x76, 
    0x70,0x2F,0x68,0x6F,0x6C,0x6F,0x61,0x72,0x6B,0x5F,0x64,0x69,0x61,0x67,0x2E,0x7A,0x69,0x70};
  byte dataFormatIdentifier = 0x11;
  byte fileSizeParameterLength = 0x03;
  byte fileSizeUncompressed[3] = {0x07,0xF8,0x00};
  byte fileSizeCompressed[3] = {0x02,0x78,0x2F};
  byte buffer[43];
  int i=0;
  
  buffer[0] = functionid;
  buffer[1] = 0x01;//mode of Operation
  buffer[2] = 0x00;
  buffer[3] = filePathandNameLength;
  for(i=0;i<31;i++)
  {
    buffer[4+i] = filePathandName[i];
  }
  
  buffer[35] = 0x11;
  buffer[36] = 0x03;
  buffer[37] = 0x07;
  buffer[38] = 0xF8;
  buffer[39] = 0x00;
  buffer[40] = 0x02;
  buffer[41] = 0x78;
  buffer[42] = 0x2F; 
  
  DoIP_DataReq(buffer, 43, vehicleLogicAddress, TesterLogicalAddress);
}


//$38服务，通过panel获取相关参数
testfunction RequestFileTransfer1(byte subfunction_id)
{
  byte functionid = 0x38;
  word filePathandNameLength = 0x1F;
  byte filePathandName[1024];
  byte dataFormatIdentifier    = 0x11; //可手动修改
  byte fileSizeParameterLength = 0x04; //可手动修改
  byte buffer[1024];
  int i=0;
  
  if(subfunction_id == 0x01) //文件传输子功能
  {
    buffer[0] = functionid;
    buffer[1] = subfunction_id;//mode of Operation
    buffer[2] = (byte)(filePathandNameLength>>8);
    buffer[3] = (byte)filePathandNameLength;
    if(_Update_Target_Path_Size > 0)
    {
      for(i = 0; i < _Update_Target_Path_Size;i++)
      {
        buffer[4+i] = _Update_Target_Path[i];
      }
    }
    else
    {
      putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","目标路径长度错误，请检查\n");
    }
    
    buffer[5+_Update_Target_Path_Size]  = dataFormatIdentifier;
    buffer[6+_Update_Target_Path_Size]  = fileSizeParameterLength;
    buffer[7+_Update_Target_Path_Size]  = (byte)(_Update_File_Uncompressed_Size>>24);
    buffer[8+_Update_Target_Path_Size]  = (byte)(_Update_File_Uncompressed_Size>>16);
    buffer[9+_Update_Target_Path_Size]  = (byte)(_Update_File_Uncompressed_Size>>8);
    buffer[10+_Update_Target_Path_Size] = (byte)(_Update_File_Uncompressed_Size);
    buffer[11+_Update_Target_Path_Size] = (byte)(_Update_File_Compressed_Size>>24);
    buffer[12+_Update_Target_Path_Size] = (byte)(_Update_File_Compressed_Size>>16);
    buffer[13+_Update_Target_Path_Size] = (byte)(_Update_File_Compressed_Size>>8);
    buffer[14+_Update_Target_Path_Size] = (byte)(_Update_File_Compressed_Size);
    
    DoIP_DataReq(buffer, (14+_Update_Target_Path_Size), vehicleLogicAddress, TesterLogicalAddress);
    
  }
  else if(subfunction_id == 0x06) //断电续传
  {
    //TBD.
  }
  else
  {
    //no code.
  }
}


