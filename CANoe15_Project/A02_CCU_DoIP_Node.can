on key '4'
{
  byte FilePathandNameLength[2]  = {0x00,0x2F};
  byte FilePathandName[47]       = {0x2F,0x68,0x6F,0x6D,0x65,0x2F,0x71,0x69,0x61,0x6E,0x70,0x65,0x6E,0x67,0x70,0x65,0x6E,0x67,0x2F,0x75,0x70,0x64,0x61,0x74,0x65,0x5F,0x74,0x65,0x73,0x74,0x2F,0x68,0x6F,0x6C,0x6F,0x61,0x72,0x6B,0x5F,0x64,0x69,0x61,0x67,0x2E,0x7A,0x69,0x70};//"/home/qianpengpeng/update_test/holoark_diag.zip";
  byte Data_Format_Identifier[1] = {0x11};
  byte File_Size[1]              = {0x03};
  byte fileSizeUncompressed[3]   = {0x07,0xF8,0x00};//0x0007F800;
  byte fileSizeCompressed[3]     = {0x02,0x78,0x2F};//0x0002782F;
  //RequestFileTransfer1(0x01);
  
  //FilePathandNameLength:"/home/qianpengpeng/update_test/holoark_diag.zip"
  diagSetParameterRaw(_0x38Service_0x01_sub,"FilePathandNameLength",FilePathandNameLength,2);
  
  //FilePathandName:
  diagSetParameterRaw(_0x38Service_0x01_sub,"FilePathandName",FilePathandName,0x2F);
  
  //Data Format Identifier:
  diagSetParameterRaw(_0x38Service_0x01_sub,"DataFormatIdentifier",Data_Format_Identifier,1);
  
  //File Size:
  diagSetParameterRaw(_0x38Service_0x01_sub,"FileSize",File_Size,1);
  
  //fileSizeUncompressed:
  diagSetParameterRaw(_0x38Service_0x01_sub,"fileSizeUncompressed",fileSizeUncompressed,3);
  
  //fileSizeCompressed:
  diagSetParameterRaw(_0x38Service_0x01_sub,"fileSizeCompressed",fileSizeCompressed,3);
  
  diagSendRequest(_0x38Service_0x01_sub);
}

on key '5'
{
  int binsize = 0;
  byte buffer_bin[0xFFFD];//这里的上限是4G，但是脚本中的buffer不允许超过0xFFFF
  byte data[0xFFFF];
  long retSize;
  int i;
  byte index[1] = {0x01};//首次为1，大于255之后为0，再次递增
  
  // Opens the file in binary mode for read access.
  glbHandle = OpenFileRead ("C:\\Users\\holo\\Desktop\\CD_test\\holoark_diag.zip",1);
  //glbHandle = OpenFileRead (_Update_Target_Path,1);
  
  if ( glbHandle!=0 )
  {
    write("升级文件读取正确");
    do{
        retSize = fileGetBinaryBlock(buffer_bin,elcount(buffer_bin),glbHandle);
        if(retSize == 0) 
          break;
        write("retSize = %d",  retSize);
        diagSetParameterRaw(_0x36Service,"Block_Sequence_Counter",index,1);
        diagSetParameterRaw(_0x36Service,"Transfer_Request_Parameter_Record",buffer_bin,retSize);
        diagSendRequest(_0x36Service);
        index[0] += 1;
        if(index[0] > 255) index[0] = 0;
        testWaitForTimeout(1000);
    }while(retSize > 0);   
    fileClose (glbHandle);      
  }
  else
  {
    putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件读取失败，请检查\n");
  }
