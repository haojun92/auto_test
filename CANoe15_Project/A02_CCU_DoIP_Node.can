_diag_GetError(char buffer[])
{
  snprintf(gDebugBuffer,elCount(gDebugBuffer),"%s",buffer);
  write("CALLBACK %s",gDebugBuffer);
}

on preStart
{
  char buffer[256];
  DoIP_SetLocalIPaddress("172.16.0.200");//CANoe节点IP
  DoIP_SetVehicleAddress("172.16.0.14"); //被测服务端节点IP
  DoIP_SetTesterLogicalAddress(TesterLogicalAddress);
  DoIP_SetVehicleLogicalAddress(vehicleLogicAddress);
  DoIP_InitAsTester();
  
}

//read file and get info
On key 'w'
{ 
  RequestFileTransfer();
}

//on key 't'
testfunction _36_service()
{
  int binsize = 0;
  byte buffer_bin[0xFFFD];//这里的上限是4G，但是脚本中的buffer不允许超过0xFFFF
  byte data[0xFFFF];
  long retSize;
  int i;
  int index = 1;//首次为1，大于255之后为0，再次递增
  
  // Opens the file in binary mode for read access.
  glbHandle = OpenFileRead ("C:\\Users\\holo\\Desktop\\CD_test\\holoark_diag.zip",1);
  //glbHandle = OpenFileRead (_Update_Target_Path,1);
  
  if ( glbHandle!=0 )
  {
    putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件读取正确\n");
    do{
        retSize = fileGetBinaryBlock(buffer_bin,elcount(buffer_bin),glbHandle);
        write("retSize:%d",retSize);
        putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","retSize:");
        putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",retSize);
//        for(i=0;i< retSize;i++)
//        {
//          writeLineEx (mNewPage,1,"buffer_bin[%d]: %x.",i,buffer_bin[i]);
//        }
        data[0] = 0x36;
        data[1] = index;
        index++;
        for(i = 0; i < retSize; i++)
        {
          data[2+i] = buffer_bin[i];
        }
        
        TransferData(data,(retSize+2));
        sysSetVariableInt(sysvar::DoIP::upgradeprogressvalue,index);
        testWaitForTimeout(1000);
    }while(retSize > 0);   
    fileClose (glbHandle);      
  }
  else
  {
    putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件读取失败，请检查\n");
  }
//  data[0] = 0x36;
//  data[1] = 0x01;
//  for(i = 0; i < 0x500; i++)
//  {
//    data[2+i] = buffer_bin[i];
//  }
  
//  TransferData(data,0x501);
  upgradecompleteflag = 3;
}

