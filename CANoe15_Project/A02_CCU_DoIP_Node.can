//获取升级文件名和文件路径
on sysvar_update sysvar::DoIP::filenameandpath
{
  sysGetVariableString(sysvar::DoIP::filenameandpath,_Update_Filename,elCount(_Update_Filename));
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件路径:");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",_Update_Filename);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","\n");
  _Update_File_Size = sysGetVariableArrayLength(sysvar::DoIP::filenameandpath);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","update file path size:");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",_Update_File_Size);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","\n");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件加载完成\n");
}

//获取升级目标路径&文件名
on sysvar_update sysvar::DoIP::upgradetargetpath
{  
  sysGetVariableString(sysvar::DoIP::upgradetargetpath,_Update_Target_Path,elCount(_Update_Target_Path));
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级目标路径&文件名称:");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",_Update_Target_Path);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","\n");
  _Update_Target_Path_Size = sysGetVariableArrayLength(sysvar::DoIP::upgradetargetpath);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","update target path size:");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",_Update_Target_Path_Size);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","\n");
}


//获取升级文件未压缩时的字节数
on sysvar_update sysvar::DoIP::UpdateFileUncompressedSizeValue
{
  _Update_File_Uncompressed_Size = sysGetVariableInt(sysvar::DoIP::UpdateFileUncompressedSizeValue);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件未压缩大小(bytes)：");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",_Update_File_Uncompressed_Size);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","\n");
}


//获取升级文件压缩后的字节数
on sysvar_update sysvar::DoIP::UpdateFileCompressedSizeValue
{
  _Update_File_Compressed_Size = sysGetVariableInt(sysvar::DoIP::UpdateFileCompressedSizeValue);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","升级文件未压缩大小(bytes)：");
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View",_Update_File_Compressed_Size);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","\n");
}


//手动请求Level_01 seed&Key
on key 's'
{
  write("diagSendRequest(gSeedReq_0x01)");
  diagSendRequest(gSeedReq_0x01);
}

//手动请求Level_21 seed&Key
on key 'S'
{
  write("diagSendRequest(gSeedReq_0x21)");
  diagSendRequest(gSeedReq_0x21);
}

testfunction securityRequsetSeed(byte subid)
{
  byte functionid = 0x21;
  byte buffer[2];
  buffer[0] = functionid;
  buffer[1] = subid;
  DoIP_DataReq(buffer, 2, vehicleLogicAddress, TesterLogicalAddress);
}

//计算秘钥0x01
on diagResponse HoloArk_ADC.SeedLevel1_Request
{
  int i;
  long ret;
  
  this.GetParameterRaw("SecuritySeed",gTesterSeedArray,elCount(gTesterSeedArray));
  write("Security Level = %x",(byte)diagGetParameter(this,"SecurityAccessType"));
  for(i=0;i<gTesterSeedArrySize;i++)
  {
    write("0x01_testerSeedArray[%d] = %x",i,gTesterSeedArray[i]);
  }
  
  diagSetTarget("HoloArk_ADC");
  ret=diagGenerateKeyFromSeed(gTesterSeedArray,gTesterSeedArrySize,gSecurityLevel_0x01,gVarinat,gOption,gAdcKeyArray,gMaxKeyArraySize,gAdcKeyArrySize);
  write("Result of Tester GenerateKeyFromSeed:%d",ret);
  
  for(i = 0; i < gAdcKeyArrySize; i++)
  {
    write("0x02_gAdcKeyArray[%d] = %X",i,gAdcKeyArray[i]);
  }
  diagSetParameterRaw(gKeyReq_0x02,"SecurityKey",gAdcKeyArray,gAdcKeyArrySize);
  diagSendRequest(gKeyReq_0x02);
}

on diagResponse HoloArk_ADC.RequestSeed_0x21_Request
{
  int i;
  long ret;
  
  this.GetParameterRaw("SecuritySeed",gTesterSeedArray,elCount(gTesterSeedArray));
  write("Security Level = %x",(byte)diagGetParameter(this,"SecurityAccessType"));
  for(i=0;i<gTesterSeedArrySize;i++)
  {
    write("0x21_testerSeedArray[%d] = %x",i,gTesterSeedArray[i]);
  }
  
  diagSetTarget("HoloArk_ADC");
  ret=diagGenerateKeyFromSeed(gTesterSeedArray,gTesterSeedArrySize,gSecurityLevel_0x21,gVarinat,gOption,gAdcKeyArray,gMaxKeyArraySize,gAdcKeyArrySize);
  write("Result of Tester GenerateKeyFromSeed:%d",ret);
  
  for(i = 0; i < gAdcKeyArrySize; i++)
  {
    write("0x22_gAdcKeyArray[%d] = %X",i,gAdcKeyArray[i]);
  }
  diagSetParameterRaw(gKeyReq_0x22,"SecurityKey",gAdcKeyArray,gAdcKeyArrySize);
  diagSendRequest(gKeyReq_0x22);
}


