/*@!Encoding:936*/
includes
{
  
}

variables
{
  //DoIP相关参数
  const dword TesterLogicalAddress = 0x0E80;
  const dword vehicleLogicAddress  = 0xE;
  
  char gDiagTarget[10] = "ADC";
  const byte KeySize = 4;
  byte gTesterSeedArray[KeySize];
  byte gAdcKeyArray[KeySize];
  int gTesterSeedArrySize = 4;
  dword gAdcKeyArrySize = 4;
  int gSecurityLevel_0x01 = 0x01;
  int gSecurityLevel_0x21 = 0x21;
  diagRequest HoloArk_ADC.SeedLevel1_Request        gSeedReq_0x01;
  diagRequest HoloArk_ADC.KeyLevel1_Send            gKeyReq_0x02;
  diagRequest HoloArk_ADC.RequestSeed_0x21_Request  gSeedReq_0x21;
  diagRequest HoloArk_ADC.SendKey_0x22_Send         gKeyReq_0x22;
  char gVarinat[200] = "Common";
  char gOption[200] = "";
  int gMaxKeyArraySize = 4;
  char gDebugBuffer[2000];
  
  dword glbHandle=0;
  long mNewPage; // Sink identifier
  byte upgradecompleteflag = 0;
  
  //升级相关全局变量
  dword _Update_Target_Path_Size = 0;
  char  _Update_Target_Path[1024];
  long _Update_File_Uncompressed_Size = 0;
  long _Update_File_Compressed_Size   = 0;
  char _Update_Filename[1024];
  dword _Update_File_Size = 0;
  
  
  diagRequest HoloArk_ADC.DefaultSession_Start              _0x10Service_0x01_sub;
  diagRequest HoloArk_ADC.ExtendedDiagnosticSession_Start   _0x10Service_0x03_sub;
  diagRequest HoloArk_ADC.File_Transfer_Transmit            _0x36Service;
  diagRequest HoloArk_ADC.Upload_Download_Stop              _0x37Service;
  diagRequest HoloArk_ADC.File_Transfer_Add                 _0x38Service_0x01_sub;
  
  //0x31服务的诊断请求句柄
  diagRequest HoloArk_ADC.CheckDownloadPreconditions_Start         _0x31_01_2101_Rq;
  diagRequest HoloArk_ADC.StartCheckFileSHA256Value_Start          _0x31_01_2102_Rq;
  diagRequest HoloArk_ADC.StartSoftwareInstallation_Start          _0x31_01_2103_Rq;
  diagRequest HoloArk_ADC.StartFullPackageCheck_Start              _0x31_01_2105_Rq;
  diagRequest HoloArk_ADC.StartSoftwareRecovery_Start              _0x31_01_2110_Rq;
  diagRequest HoloArk_ADC.StartSoftwareRecovery_Results            _0x31_03_2110_Rq;
  diagRequest HoloArk_ADC.StartABPartitionSynchronization_Start    _0x31_01_2111_Rq;
  diagRequest HoloArk_ADC.StartABPartitionSynchronization_Results  _0x31_03_2111_Rq;
  diagRequest HoloArk_ADC.StartSoftwareRecovery_1_Start            _0x31_01_2112_Rq;
  diagRequest HoloArk_ADC.StartSoftwareRecovery_1_Results          _0x31_03_2112_Rq;
  diagRequest HoloArk_ADC.StartSoftwareVerification_Start          _0x31_01_2113_Rq;
  diagRequest HoloArk_ADC.StartSoftwareVerification_Results        _0x31_03_2113_Rq;
}

//"开始升级"
on sysvar_update sysvar::DoIP::upgradebuttonvalue
{
  char display_buffer[256];
  long copiedBytes;
  if(sysGetVariableInt(sysvar::DoIP::upgradebuttonvalue) == 1)
  {
    putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","配置信息：\n");
    
    diagSendRequest(_0x10Service_0x01_sub);
    testWaitForTimeout(500);
    diagSendRequest(_0x10Service_0x03_sub);
    testWaitForTimeout(500);
    
    diagSendRequest(gSeedReq_0x21);
    testWaitForTimeout(500);
    
    //copiedBytes = getValue(sysvar::DoIP::securitycertificationdllpath,pathbuffer);
    putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","开始升级\n");
    
    RequestFileTransfer1(0x01);
    testWaitForTimeout(1000);
    
    _36_service();
    
    diagSendRequest(_0x37Service);
  }
}


//"开始升级"
on key 'U'
{
  char display_buffer[256];
  long copiedBytes;

  //putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","配置信息：\n");
  
  //diagSendRequest(_0x10Service_0x01_sub);
  //testWaitForTimeout(1000);
  //diagSendRequest(_0x10Service_0x03_sub);
  //testWaitForTimeout(1000);
  
  //diagSendRequest(gSeedReq_0x21);
  //testWaitForTimeout(1000);
  
  //copiedBytes = getValue(sysvar::DoIP::securitycertificationdllpath,pathbuffer);
  putValueToControl("HolomaticDoIPUpdatePanel","CAPL_Output_View","开始升级\n");
  
  DiagnosticSessionControl(0x01);
  DiagnosticSessionControl(0x03);
  RequestFileTransfer1(0x01);
  //testWaitForTimeout(1000);
  
  _36_service();
  
  //diagSendRequest(_0x37Service);
}

