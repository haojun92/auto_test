</TRRECORDITEMTMPL>
<ENUMRECORDITEMTMPL id='_09262728' oid='C5AD643B63E747e783697DC0FB81903D' temploid='592AA60CB00546b98BFA2B32157D3534' mayBeDup='1' conv='opt' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>DTCPriority</TUV>
</NAME>
<QUAL>DTCPriority</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>invalid value, not available</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>Error with heavy impact on the car availability. The car is not ready to start.</TUV>
</ETAG>
<ETAG v='2'>
<TUV xml:lang='en-US'>Error, which requires a direct visit of the repair shop.</TUV>
</ETAG>
<ETAG v='3'>
<TUV xml:lang='en-US'>Error, which NOT requires a direct visit of the repair shop, but can be done within a service.</TUV>
</ETAG>
<ETAG v='4'>
<TUV xml:lang='en-US'>Error, which leads to a need for action before the car can be moved; maybe the availability of the car is limited.</TUV>
</ETAG>
<ETAG v='5'>
<TUV xml:lang='en-US'>(reserved Level 5)</TUV>
</ETAG>
<ETAG v='6'>
<TUV xml:lang='en-US'>Message with influence on the abrasion level and therefore relevant for the service (e.g. fill level/abrasion critical, aging)</TUV>
</ETAG>
<ETAG v='7'>
<TUV xml:lang='en-US'>Message has influence on the comfort, but does not influence the availability of the car.</TUV>
</ETAG>
<ETAG v='8'>
<TUV xml:lang='en-US'>General message</TUV>
</ETAG>
<ETAG v='9'>
<TUV xml:lang='en-US'>Message for development</TUV>
</ETAG>
</ENUMRECORDITEMTMPL>
