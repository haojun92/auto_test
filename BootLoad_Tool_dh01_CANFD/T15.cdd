<UNSDEF id='_0925F080' oid='7F8C64598ECD4eba965A70AA2C487641' temploid='{47702186-8AF5-428e-84A2-910211B0FA17}' attrcatref='_03FA7FD0' usage='admin' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>Diag_CAN.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0925F178' oid='58F8852A8B7148b7A2DE8059326C2418' temploid='DD1DF71FBA84476b89097B385578D563' attrcatref='_03FA7FD0' usage='admin' v='1872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for functional requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority. </TUV>
</DESC>
<QUAL>Diag_CAN.ReqCanIdFunc</QUAL>
</UNSDEF>
