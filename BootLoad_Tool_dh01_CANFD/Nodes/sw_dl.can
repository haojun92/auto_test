void CalcuteTheDateTime(void)
{
   // now tm contains the following entries:
  // tm[0] = 3; (seconds)
  // tm[1] = 51; (minutes)
  // tm[2] = 16; (hours)
  // tm[3] = 21; (day of month)
  // tm[4] = 7; (month stating with 0)
  // tm[5] = 98; (year)
  // tm[6] = 5; (weekday)
  // tm[7] = 232;(day of year)
  // tm[8] = 1; (Summer time)
  long yearstr;
  yearstr = tm[5]-100;
  TimeDateStr[0]= 0x20;
  TimeDateStr[1]= (yearstr/10)*16+ (yearstr%10);
  TimeDateStr[2] = ((tm[4]+1)/10)*16 + ((tm[4]+1)%10);
  TimeDateStr[3] = (tm[3]/10)*16 + (tm[3]%10);
}

