    gTxDataBuffer[2] = 0x99;
    gTxDataBuffer[3] = TimeDateStr[0];
    gTxDataBuffer[4] = TimeDateStr[1];
    gTxDataBuffer[5] = TimeDateStr[2];
    gTxDataBuffer[6] = TimeDateStr[3];
    txCount = 7;
    CurrentTransIndex = 0;
    OSEKTL_DataReq(gTxDataBuffer, txCount);
}



dword CalculateBlockDataCrc32(char type, int block)
{ 
  dword Cnt = 0;
  int blockStart;
  dword filechecksum;
  filechecksum = 0xFFFFFFFF;
  init_crc_table();
  if(type == FLASHDATA)
    {
      if(block< DataBlockTotalNum)
      {   
          blockStart = DataBlockStartIndex[block];
          while(Cnt < DataBlockLength[block])
          {
              if(Cnt + 1024 < DataBlockLength[block])
              {
                 filechecksum = crc32(filechecksum,DataStr[blockStart],1024);
                 Cnt +=1024;
                  blockStart++; 
              }
              else
              {
                 filechecksum = crc32(filechecksum,DataStr[blockStart],DataBlockLength[block] - Cnt);
                 Cnt = DataBlockLength[block];
              }
          }
      }
    }
    else
    {
       if(block< DrvBlockTotalNum)
      {
          blockStart = DrvBlockStartIndex[block];
          while(Cnt < DrvBlockLength[block])
          {
              if(Cnt + 1024 < DrvBlockLength[block])
              {
                 filechecksum = crc32(filechecksum,DrvStr[blockStart],1024);
                 Cnt +=1024;
                  blockStart++; 
              }
              else
              {
                 filechecksum = crc32(filechecksum,DrvStr[blockStart],DrvBlockLength[block] - Cnt);
                 Cnt = DrvBlockLength[block];
              }
          }
      }
    }
    return filechecksum;
}

void DiagCheckFileChecksum(void)
{
    Diag_Status = SetCalculateChecksum;
//  IsDiagWaitResp = 1;
    gTxDataBuffer[0] = 0x31;
    gTxDataBuffer[1] = 0x01;
    gTxDataBuffer[2] = 0x02;
    gTxDataBuffer[3] = 0x02;
    if(IsDrvFileDownload == 1)
    {
       file_checksum = CalculateBlockDataCrc32(FLASHDRIVER,CurrentTransIndex);
    }
    else
    {
      file_checksum = CalculateBlockDataCrc32(FLASHDATA,CurrentTransIndex);
    }
    gTxDataBuffer[4] = (byte)(file_checksum>>24);
    gTxDataBuffer[5] = (byte)(file_checksum>>16);
    gTxDataBuffer[6] = (byte)(file_checksum>>8);
    gTxDataBuffer[7] = (byte)(file_checksum);
    txCount = 8;
    OSEKTL_DataReq(gTxDataBuffer, txCount);  
    //OSEKTL_DataInd
}

void DiagCheckFileChecksumResp(void)
{
  write("the checksum resp is received!");  
  if((gRxDataBuffer[0] == 0x7F)&&(gRxDataBuffer[1]==0x31)&&(gRxDataBuffer[2]==0x78))
    {
    }
    else if((gRxDataBuffer[0] == 0x71)&&(gRxDataBuffer[1]== 0x01)&&(gRxDataBuffer[4]== 0x04))
    {
      CurrentTransIndex++;
      write("Flash Driver was Download Finished!!!");
      if(IsDrvFileDownload == 1)
      {
        if(CurrentTransIndex >= DrvBlockTotalNum)
        {
          IsDrvFileDownload = 0;
          write("Flash Driver was Download Finished!!!");
          putValue(PromgramIndicationStr, "Flash Driver was Download Finished!!!");
          CurrentTransIndex = 0;
          DiagEraseFlashSector();
        }
      }
      else
      {
        write("the transfer block index is %d, the code block total num is %d",CurrentTransIndex,DataBlockTotalNum);
        if(CurrentTransIndex >= DataBlockTotalNum)
        {
           putValue(PromgramIndicationStr, "Code Data was Download Finished!!!"); 
          DiagCheckProgramDependency();
        }else
        {
         // putValue(PromgramIndicationStr, "Transfer the next block Code data!!!");
          DiagEraseFlashSector();
        }
        
      }
    }
}


void DiagEraseFlashSector(void)
{
    Diag_Status = StartEraseMemoryProcedure; 
//   IsDiagWaitResp = 1;
    gTxDataBuffer[0] = 0x31;
    gTxDataBuffer[1] = 0x01;
    gTxDataBuffer[2] = 0xff;
    gTxDataBuffer[3] = 0x00;
    gTxDataBuffer[4] = 0x44;
    
    gTxDataBuffer[5] = (byte)(DataBlockAddr[CurrentTransIndex]>>24);
    gTxDataBuffer[6] = (byte)(DataBlockAddr[CurrentTransIndex]>>16);
    gTxDataBuffer[7] = (byte)(DataBlockAddr[CurrentTransIndex]>>8);
    gTxDataBuffer[8] = (byte)(DataBlockAddr[CurrentTransIndex]);
  
    gTxDataBuffer[9] = (byte)(DataBlockLength[CurrentTransIndex]>>24);
    gTxDataBuffer[10] = (byte)(DataBlockLength[CurrentTransIndex]>>16);
    gTxDataBuffer[11] = (byte)(DataBlockLength[CurrentTransIndex]>>8);
    gTxDataBuffer[12] = (byte)(DataBlockLength[CurrentTransIndex]);
    txCount = 13;
    OSEKTL_DataReq(gTxDataBuffer, txCount);
   
}

void DiagEraseFlashSectorResp(void)
{
    if((gRxDataBuffer[0] == 0x7F)&&(gRxDataBuffer[1]==0x31)&&(gRxDataBuffer[2]==0x78))
    {
    }else if((gRxDataBuffer[0] == 0x71)&&(gRxDataBuffer[1]== 0x01)&&(gRxDataBuffer[4]== 0x04))
    {
       DiagRequestDownloadData();
    }
}

void DiagWriteProgramDateResp(void)
{
    if((gRxDataBuffer[0] == 0x6E)&&(gRxDataBuffer[1]== 0xF1)&&(gRxDataBuffer[2]== 0x99))
    {
      //write("IsDrvFileNeed is %d,IsDrvFileValid is %d ",IsDrvFileNeed,IsDrvFileValid);
      if((IsDrvFileNeed==1)&&(IsDrvFileValid==1))
      {
        
        IsDrvFileDownload = 1;
        CurrentTransIndex = 0;
        DiagRequestDownloadData();
      }
      else
      {
        IsDrvFileDownload = 0;
        CurrentTransIndex = 0;
        DiagEraseFlashSector();
      }
      //write("IsDrvFileDownload is %d",IsDrvFileDownload); 
    }
    else{
      DiagWriteProgramSerialNum();
    }
}


void DiagRequestDownloadData(void)
{
    Diag_Status = RequestDownload; 
//    IsDiagWaitResp = 1;
    gTxDataBuffer[0] = 0x34;
    gTxDataBuffer[1] = 0x00;
    gTxDataBuffer[2] = 0x44;
    if(IsDrvFileDownload == 1)
    {
      gTxDataBuffer[3] = (byte)(DrvBlockAddr[CurrentTransIndex]>>24);
      gTxDataBuffer[4] = (byte)(DrvBlockAddr[CurrentTransIndex]>>16);
      gTxDataBuffer[5] = (byte)(DrvBlockAddr[CurrentTransIndex]>>8);
      gTxDataBuffer[6] = (byte)(DrvBlockAddr[CurrentTransIndex]);
    
      gTxDataBuffer[7] = (byte)(DrvBlockLength[CurrentTransIndex]>>24);
      gTxDataBuffer[8] = (byte)(DrvBlockLength[CurrentTransIndex]>>16);
      gTxDataBuffer[9] = (byte)(DrvBlockLength[CurrentTransIndex]>>8);
      gTxDataBuffer[10] = (byte)(DrvBlockLength[CurrentTransIndex]);
    }
    else
    {
      gTxDataBuffer[3] = (byte)(DataBlockAddr[CurrentTransIndex]>>24);
      gTxDataBuffer[4] = (byte)(DataBlockAddr[CurrentTransIndex]>>16);
      gTxDataBuffer[5] = (byte)(DataBlockAddr[CurrentTransIndex]>>8);
      gTxDataBuffer[6] = (byte)(DataBlockAddr[CurrentTransIndex]);
    
      gTxDataBuffer[7] = (byte)(DataBlockLength[CurrentTransIndex]>>24);
      gTxDataBuffer[8] = (byte)(DataBlockLength[CurrentTransIndex]>>16);
      gTxDataBuffer[9] = (byte)(DataBlockLength[CurrentTransIndex]>>8);
      gTxDataBuffer[10] = (byte)(DataBlockLength[CurrentTransIndex]);
    }
    txCount = 11;
    OSEKTL_DataReq(gTxDataBuffer, txCount);
    CurrentBlockIndex = 0;
    CurrentBlockCnt = 0;
    CurrPos = 0;
    CurrBlock = DataBlockStartIndex[CurrentTransIndex];
    write("the CurrentTransIndex is %d", CurrentTransIndex);
    
}

void DiagRequestDownloadDataResp(void)
{
    if((gRxDataBuffer[0] == 0x7F)&&(gRxDataBuffer[1]==0x34)&&(gRxDataBuffer[2]==0x78))
    {
    }else if((gRxDataBuffer[0] == 0x74)&&(gRxDataBuffer[1]== 0x40))
    {
       //if(CurrentBlockPos>= DataBlockLength[CurrentTransIndex])
       {
          TransferBlockSize = gRxDataBuffer[5];
          TransferBlockSize += (dword)(gRxDataBuffer[4]<<8);
          TransferBlockSize += (dword)(gRxDataBuffer[3]<<16);
          TransferBlockSize += (dword)(gRxDataBuffer[2]<<24);
          TransferBlockSize -=2;
          //write("the transfer block size is %d", TransferBlockSize);  
          DiagTransferData();
       }
    }
}

void DiagTransferData(void)
{
    long i;
    long Len;
    Diag_Status = TransferDataBlock;  
//    IsDiagWaitResp = 1;
    if(IsDrvFileDownload == 1)
    {
      write("drv is transfer");  
      if(CurrentBlockCnt + TransferBlockSize>DrvBlockLength[CurrentTransIndex])
        {
          Len = DataBlockLength[CurrentTransIndex] - CurrentBlockCnt;
        }
        else
        {
          Len = TransferBlockSize;
        }
//        write("the transfer block size is %d",DrvBlockLength[CurrentTransIndex]);
//        write("the CurrentBlockCnt is %d",CurrentBlockCnt);
//        write("the Len is %d",Len);
    }
    else
    {
        if(CurrentBlockCnt + TransferBlockSize>DataBlockLength[CurrentTransIndex])
        {
          Len = DataBlockLength[CurrentTransIndex] - CurrentBlockCnt;
        }
        else
        {
          Len = TransferBlockSize;
        }
//        write("the transfer Data block size is %d",DataBlockLength[CurrentTransIndex]);
//        write("the CurrentBlockCnt is %d",CurrentBlockCnt);
//        write("the Len is %d",Len);
    }
    CurrentBlockCnt += Len;
    //write("this block length is %X,%",Len,Len);
    gTxDataBuffer[0] = 0x36;
    gTxDataBuffer[1] = CurrentBlockIndex;
    CurrentTotalLen +=Len; 
    if(IsDrvFileDownload == 1)
    {  
      write("the drv str CurrBlock is %d,CurrPos is %d ",CurrBlock,CurrPos);
      for(i=0;i < Len;i++)
      { 
        gTxDataBuffer[2+i] = DrvStr[CurrBlock][CurrPos];
        if(++CurrPos>=1024)
        {
          CurrBlock++;
          CurrPos=0;
        }
      }
    }else
    {
       //write("the Code str CurrBlock is %d,CurrPos is %d ",CurrBlock,CurrPos); 
      for(i=0;i < Len;i++)
      {   
        gTxDataBuffer[2+i] = DataStr[CurrBlock][CurrPos];
        if(++CurrPos>=1024)
        {
          CurrBlock++;
          CurrPos=0;
        }
      }
    }
    txCount = 2 + Len;
    OSEKTL_DataReq(gTxDataBuffer, txCount); 
    
//    IsDiagWaitResp = 1;
}

void DiagTransferDataResp(void)
{
    //write("the transfer resp received!");
    if((gRxDataBuffer[0] == 0x7F)&&(gRxDataBuffer[1]==0x36)&&(gRxDataBuffer[2]==0x78))
    {
    }
    else if((gRxDataBuffer[0] == 0x76)&&(gRxDataBuffer[1]== CurrentBlockIndex))
    {
       putValue(ProgramProcessBar, CurrentTotalLen*100/(DataTotalLen + DrvTotalLen)); 
       if(IsDrvFileDownload == 1)
       {
          if(CurrentBlockCnt>= DrvBlockLength[CurrentTransIndex])
          {
              DiagStopTransferData(); 
          }else
          {
            CurrentBlockIndex++; 
            DiagTransferData();
          }
       } 
      else
      {
        write("Code transfer index is 0x%X",CurrentBlockCnt);
        if(CurrentBlockCnt>= DataBlockLength[CurrentTransIndex])
          {
             DiagStopTransferData(); 
          }
          else
          {
            CurrentBlockIndex++; 
            DiagTransferData();
          }
      }
    }
}

void DiagStopTransferData(void)
{
    Diag_Status = StopTransferData;  
//    IsDiagWaitResp = 1;
    gTxDataBuffer[0] = 0x37;
    gTxDataBuffer[1] = (byte)(CurrentTransIndex);      
    txCount = 2;
    OSEKTL_DataReq(gTxDataBuffer, txCount);
}

void DiagStopTransferDataResp(void)
{
    if(gRxDataBuffer[0] == 0x77)
    {
       DiagCheckFileChecksum();
    }
}

void DiagCheckProgramDependency(void)
{
    Diag_Status = CheckProgramDependency;  
//    IsDiagWaitResp = 1;
    gTxDataBuffer[0] = 0x31;
    gTxDataBuffer[1] = 0x01;
    gTxDataBuffer[2] = 0xFF;
    gTxDataBuffer[3] = 0x01;
    txCount = 4;
    OSEKTL_DataReq(gTxDataBuffer, txCount);
  
}
void DiagCheckProgramDependencyResp(void)
{
    if((gRxDataBuffer[0] == 0x7F)&&(gRxDataBuffer[1]==0x36)&&(gRxDataBuffer[2]==0x78))
    {
    }
    else if((gRxDataBuffer[0] == 0x71)&&(gRxDataBuffer[1]== 0x01)&&(gRxDataBuffer[4]== 0x04))
    {
       
       DiagResetMcu();
    }
  
}

      
void DiagResetMcu(void)
{
    Diag_Status = RequestResetMcu;    
    gTxDataBuffer[0] = 0x11;
    gTxDataBuffer[1] = 0x01;
    txCount = 2;
    OSEKTL_DataReq(gTxDataBuffer, txCount);
//  IsDiagWaitResp = 1;
    @sysvar::DiagService::sysDiagFinished = 1;
    putValue(PromgramIndicationStr, "Download is successful!!!");
}

void DiagResetMcuResp(void)
{
   if((gRxDataBuffer[0] == 0x51)&&(gRxDataBuffer[1]== 0x01))
    {
      Diag_Status = DownloadFinished;
    }
}


