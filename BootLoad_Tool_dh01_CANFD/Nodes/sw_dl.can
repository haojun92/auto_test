void DiagMessageResp()
{
  long txCount; 
  write("the diagstatus is %X",Diag_Status);
  switch(Diag_Status)
  {
    case StartReProgramSection:
        DiagStartReprogramSectionResp(); 
      break;
      case RequestSecuritySeed:
        write("Seed is received!");
        DiagRequestSecuritySeedResp();
      break;
      case SendSecurityKey:
        DiagSendSecurityKeyResp();
      break;
      case WriteDownloadIdentifierNum:
         DiagWriteProgramSerialNumResp();
      break;
      case WriteDownloadDate:
      DiagWriteProgramDateResp();
      break;
      case StartEraseMemoryProcedure:
      DiagEraseFlashSectorResp();
      break;
      case RequestDownload:
      DiagRequestDownloadDataResp();
      break;
      case TransferDataBlock:
      DiagTransferDataResp();
      break;
      case StopTransferData:
      DiagStopTransferDataResp();
      break;
     case SetCalculateChecksum:
      DiagCheckFileChecksumResp();
      break;
      case CheckProgramDependency:
      DiagCheckProgramDependencyResp();
      break;
      case RequestResetMcu:
      DiagResetMcuResp();
      break;
    default:
      break;
  }
  
}

