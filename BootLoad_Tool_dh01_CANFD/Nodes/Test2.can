includes
{
  
}

variables
{
  char gECU[12] = "Test node2";
  long handle;


  enum gCondition{RxSize = 4098, TxSize = 4096};

  byte gRxDataBuffer[RxSize];
  byte gTxDataBuffer[TxSize];

  char gCaplRxStrBuffer[4098];
   
  byte gAddressingMode;

  // dummy must be used for SysSetVariableData(SendData_B,..)
  byte gClearData[10];
  
  msTimer tSignalRcvdData; // Signal Received Data
  
   enum DiagStatusType
    { 
      DiagNone = 0,
      ReadECUHardwareNumber = 1,
      ReadBootSoftwareIdentification =2,
      StartExtendedSession = 3,
      DisableDTCstorage =4,
      DisableNMAndCommunicationMessage =5,
      StartReProgramSection = 10,
      RequestSecuritySeed = 11,
      SendSecurityKey = 12,
      WriteDownloadIdentifierNum =13,
      WriteDownloadDate = 14,
      StartEraseMemoryProcedure =15,
      RequestDownload = 16,
      TransferDataBlock = 17,
      StopTransferData = 18,
      SetCalculateChecksum = 19,
      CheckProgramDependency =20,
      RequestResetMcu = 21, 
      DownloadFinished = 22,
      ChangeToExtendedSession = 31,
      EnableDiagnosticCommunication = 32,
      EnableDTCstorage =33,
      ChangeToDefaultSession=34
    };
    enum DiagStatusType Diag_Status;
    enum DiagStatusType Diag_State;
    message CAN_DIAG Diag_Req;
    message BCM_DiagRes Diag_Resp;
}
on start
{
   Diag_Status = StartReProgramSection;
   Diag_State = ReadECUHardwareNumber;
}

on sysvar_update sysvar::TestPanel2::Sended
{
   long txCount;
  
  // Prevent from sending when button is released

  if (@this == 0)
      return;
  
  SysGetVariableData(sysvar::TestPanel2::RxTxString, gTxDataBuffer, txCount);
  // OSEK TP supports only up to 4095 bytes per transmission

  if (txCount >= 4096)
      txCount = 4095;

  writeDbgLevel(1,"CAPL: %s: OSEKTL_DataReq mit %d Bytes", gECU, txCount);
       
   OSEKTL_DataReq(gTxDataBuffer, txCount); 
 // CanTpSendData( handle, gTxDataBuffer, txCount);
}

on sysvar_update sysvar::TestPanel2::Clear
{
   if (@this == 0)
      return;
    SysSetVariableData(sysvar::TestPanel2::RxTxString, gRxDataBuffer, 0);
  
}

on timer tSignalRcvdData 
{
  // Switch off led for RcvdData 
 // @sysvar::NodeB::RcvdData_B =0;   
}


void OSEKTL_DataInd( long rxCount )
{
  // Output of Source Address
  long src;
 // src = OSEKTL_GetSrcAdr();

  /* Print message to write window */
  write("Receive %d bytes!",rxCount);

  /* Get received data */
  OSEKTL_GetRxData( gRxDataBuffer, elcount(gRxDataBuffer) );
  //write("the received data is [%02x]",gRxDataBuffer[0]);
  //SysSetVariableData(sysvar::TestPanel1::RxString, gRxDataBuffer, rxCount);
  //SysSetVariableData(sysvar::TestPanel2::RxTxString, gRxDataBuffer, rxCount);

  //@sysvar::NodeB::RcvdData_B = 1;
  DiagCmdResp();

}



void OSEKTL_ErrorInd(int error)
{
  switch (error)
  {
    case 1:     writeDbgLevel(1,"CAPL: %s: Error (%d): Timeout while waiting for CF", gECU, error);     break;
    case 2:     writeDbgLevel(1,"CAPL: %s: Error (%d): Timeout while waiting for FC", gECU, error);     break;
    case 3:     writeDbgLevel(1,"CAPL: %s: Error (%d): Wrong Sequence Number", gECU, error);            break;
    case 4:     writeDbgLevel(1,"CAPL: %s: Error (%d): TP_DLL busy", gECU, error);                      break;
    case 5:     writeDbgLevel(1,"CAPL: %s: Error (%d): Unexpected PDU", gECU, error);                   break;
    case 6:     writeDbgLevel(1,"CAPL: %s: Error (%d): Timeout while waiting for Tx-Ack", gECU, error); break;
    case 7:     writeDbgLevel(1,"CAPL: %s: Error (%d): WFT Overrun", gECU, error);                      break;
    case 8:     writeDbgLevel(1,"CAPL: %s: Error (%d): Buffer overflow", gECU, error);                  break;
    case 9:     writeDbgLevel(1,"CAPL: %s: Error (%d): Wrong parameter", gECU, error);                  break;    
    default:    writeDbgLevel(1,"CAPL: %s: Error (%d): unknown error", gECU, error);                    break;
  }
}

