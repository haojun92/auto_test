void DiagCmdResp(void)
{
  dword txCount;
  switch(Diag_Status)
  {
      case StartReProgramSection:
      if((gRxDataBuffer[0] == 0x10)&&(gRxDataBuffer[1] == 0x02))
      {   
        gTxDataBuffer[0] = 0x50;
        gTxDataBuffer[1] = 0x02;
        gTxDataBuffer[2] = 12;
        gTxDataBuffer[3] = 0x02;
        gTxDataBuffer[4] = 0x00;
        gTxDataBuffer[5] = 0x32;
        txCount = 6;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
        Diag_Status++;
      }
      break;
      case RequestSecuritySeed:
      if((gRxDataBuffer[0] == 0x27)&&(gRxDataBuffer[1] == 0x11))
      {   
        gTxDataBuffer[0] = 0x67;
        gTxDataBuffer[1] = 0x11;
        gTxDataBuffer[2] = 0x12;
        gTxDataBuffer[3] = 0x02;
        gTxDataBuffer[4] = 0x00;
        gTxDataBuffer[5] = 0x32;
        txCount = 6;
        
        OSEKTL_DataReq(gTxDataBuffer, txCount);
        Diag_Status++;
      }
      break;
      case SendSecurityKey:
      if((gRxDataBuffer[0] == 0x27)&&(gRxDataBuffer[1] == 0x12))
      {   
        gTxDataBuffer[0] = 0x67;
        gTxDataBuffer[1] = 0x12;
        txCount = 2;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
        Diag_Status++;
      }
      break;
      case WriteDownloadIdentifierNum:
      if((gRxDataBuffer[0] == 0x2E)&&(gRxDataBuffer[1] == 0xF1)&&(gRxDataBuffer[2] == 0x98))
      {   
        gTxDataBuffer[0] = 0x6E;
        gTxDataBuffer[1] = 0xF1;
        gTxDataBuffer[2] = 0x98; 
        txCount = 3;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
        Diag_Status++;
      }
      break;
      
      case WriteDownloadDate:
      if((gRxDataBuffer[0] == 0x2E)&&(gRxDataBuffer[1] == 0xF1)&&(gRxDataBuffer[2] == 0x99))
      {   
        gTxDataBuffer[0] = 0x6E;
        gTxDataBuffer[1] = 0xF1;
        gTxDataBuffer[2] = 0x99;
        txCount = 3;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
        Diag_Status++;
      }
      break;

     
      case RequestResetMcu:
      if((gRxDataBuffer[0] == 0x11)&&(gRxDataBuffer[1] == 0x01))
      {
        gTxDataBuffer[0] = 0x51;
        gTxDataBuffer[1] = 0x01;
        txCount = 2;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
      }
      break;
      default:
      if((gRxDataBuffer[0] == 0x31)&&(gRxDataBuffer[1] == 0x01)&&(gRxDataBuffer[2] == 0x02)&&(gRxDataBuffer[3] == 0x02))
      {
         gTxDataBuffer[0] = 0x71;
        gTxDataBuffer[1] = 0x01;
        gTxDataBuffer[2] = 0x02;
        gTxDataBuffer[3] = 0x02;
        gTxDataBuffer[4] = 0x04;
        txCount = 5;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
      }
      else if((gRxDataBuffer[0] == 0x31)&&(gRxDataBuffer[1] == 0x01)&&(gRxDataBuffer[2] == 0xFF)&&(gRxDataBuffer[3] == 0x00))
      {
        gTxDataBuffer[0] = 0x71;
        gTxDataBuffer[1] = 0x01;
        gTxDataBuffer[2] = 0xFF;
        gTxDataBuffer[3] = 0x00;
        gTxDataBuffer[4] = 0x04;
        txCount = 5;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
      }
      else if((gRxDataBuffer[0] == 0x34)&&(gRxDataBuffer[1] == 0x00)&&(gRxDataBuffer[2] == 0x44))
      {
        gTxDataBuffer[0] = 0x74;
        gTxDataBuffer[1] = 0x40;
        gTxDataBuffer[2] = 0x00;
        gTxDataBuffer[3] = 0x00;
        gTxDataBuffer[4] = 0x04;
        gTxDataBuffer[5] = 0x02;
        txCount = 6;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
      }
      else if((gRxDataBuffer[0] == 0x36))
      {
        gTxDataBuffer[0] = 0x76;
        gTxDataBuffer[1] = gRxDataBuffer[1];
        txCount = 2;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
      }
      else if((gRxDataBuffer[0] == 0x37))
      {
        gTxDataBuffer[0] = 0x77;
        txCount = 1;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
      }
      else if((gRxDataBuffer[0] == 0x31)&&(gRxDataBuffer[2] == 0xFF)&&(gRxDataBuffer[3] == 0x01))
      {   
        gTxDataBuffer[0] = 0x71;
        gTxDataBuffer[1] = 0x01;
        gTxDataBuffer[2] = 0xFF;
        gTxDataBuffer[3] = 0x01;
        gTxDataBuffer[4] = 0x04;
        txCount = 5;
        OSEKTL_DataReq(gTxDataBuffer, txCount);
        Diag_Status = RequestResetMcu;
      }
      {
      }
      break;
  }
}


on message CAN_DIAG
{
    Diag_Req = this;
   switch(Diag_State)
    {
      case ReadECUHardwareNumber:
      
      break;
      case ReadBootSoftwareIdentification:
      
      break;
      case StartExtendedSession:
      
      break;
      case DisableDTCstorage:
      
      break;
      case DisableNMAndCommunicationMessage:
      
      break;
        default :
        break;
    }    
}

void Diag_SendDataReq(byte Data[], int Num)
{
  if( Num <8)
  {
    Diag_Resp.Diag_FType = 0;
    Diag_Resp.Diag_DLength = Num;
    if(Num>=1)
    {
      Diag_Resp.Diag_D1 = Data[0];
    }else
    {
      Diag_Resp.Diag_D1 = 0;
    }
    if(Num>=2)
    {
      Diag_Resp.Diag_D2= Data[1];
    }else
    {
      Diag_Resp.Diag_D2 = 0;
    }
    if(Num>=3)
    {
      Diag_Resp.Diag_D3 = Data[2];
    }else
    {
      Diag_Resp.Diag_D3 = 0;
    }
    if(Num>=4)
    {
      Diag_Resp.Diag_D4= Data[3];
    }else
    {
      Diag_Resp.Diag_D4 = 0;
    }
    if(Num>=5)
    {
      Diag_Resp.Diag_D5 = Data[4];
    }else
    {
      Diag_Resp.Diag_D5 = 0;
    }
    if(Num>=6)
    {
      Diag_Resp.Diag_D6 = Data[5];
    }else
    {
      Diag_Resp.Diag_D6 = 0;
    }
    if(Num>=7)
    {
      Diag_Resp.Diag_D7 = Data[6];
    }else
    {
      Diag_Resp.Diag_D7 = 0;
    }
    output(Diag_Resp);
  }else
  {
    write("The data is too long for transfer out!!!");
  }
}

void DiagReadECUHardwareNumberResp(void)
{
  if((Diag_Req.Diag_D1 == 0x22)&&(Diag_Req.Diag_D2 == 0x91)&&(Diag_Req.Diag_D3 == 0x80))
  {
  }
}


