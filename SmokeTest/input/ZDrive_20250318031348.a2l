      /end XCP_ON_CAN
    /end IF_DATA
    /begin IF_DATA CANAPE_ADDRESS_UPDATE
    /end IF_DATA

    /begin MOD_PAR ""
      /begin MEMORY_SEGMENT
        CALRAM_Flash ""
        DATA FLASH INTERN 0x3B0000 0x8000 -1 -1 -1 -1 -1
        /begin IF_DATA XCP
          /begin SEGMENT
            0x00
            0x01
            0x00
            0x00
            0x00
            /begin PAGE
              0x00
              ECU_ACCESS_ALLOWED_DONT_CARE
              XCP_READ_ACCESS_ALLOWED_DONT_CARE
              XCP_WRITE_ACCESS_NOT_ALLOWED
            /end PAGE
            /begin ADDRESS_MAPPING
              0x3B0000
              0xFE820000
              0x8000
            /end ADDRESS_MAPPING
          /end SEGMENT
        /end IF_DATA
      /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT
        CALRAM ""
        DATA RAM INTERN 0xFE820000 0x8000 -1 -1 -1 -1 -1
        /begin IF_DATA XCP
          /begin SEGMENT
            0x01
            0x01
            0x00
            0x00
            0x00
            /begin PAGE
              0x00
              ECU_ACCESS_ALLOWED_DONT_CARE
              XCP_READ_ACCESS_ALLOWED_DONT_CARE
              XCP_WRITE_ACCESS_ALLOWED_DONT_CARE
              INIT_SEGMENT 0x00
            /end PAGE
          /end SEGMENT
        /end IF_DATA
      /end MEMORY_SEGMENT
    /end MOD_PAR

