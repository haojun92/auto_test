CM_ SG_ 1304 TimeSync_Type "Mode Signal: Multiplexer: 0x20 = SYNC with CRC, 0x28 = FUP with CRC, 0x10 = SYNC, 0x18 = FUP";
CM_ SG_ 1304 TimeSync_CRC "CRC calculation: AUTOSAR_SWS_CRCLibrary.pdf, function Crc_CalculateCRC8H2F()";
CM_ SG_ 1304 TimeSync_SequenceCounter "SC = Sequence Counter";
CM_ SG_ 1304 TimeSync_TimeDomain "Time Domain 0 to 15";
CM_ SG_ 1304 TimeSync_UserByte0 "Mode 32:UserByte0";
CM_ SG_ 1304 TimeSync_SyncTimeSec "Mode 32:SyncTime: seconds";
CM_ SG_ 1304 TimeSync_OverflowOfSeconds "Mode 40:OVS = Overflow of seconds, must be added to SyncTimeSec";
CM_ SG_ 1304 TimeSync_SGW "Mode 40:SyncToGTM = 0
SyncToSubDomain = 1";
CM_ SG_ 1304 TimeSync_Reserved0 "Mode 40:FUP Byte3: Bit7 to Bit3 reserved area";
CM_ SG_ 1304 TimeSync_SyncTimeNSec "Mode 40:SyncTime: nanoseconds";
CM_ SG_ 960 FRM_1_CRC "Profile5:E2E CRC16 (polynomial:0x1021)       
DataID:Use CANID,other bits Fill with 0";
